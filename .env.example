VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push (optional) — generate VAPID keys: npx web-push generate-vapid-keys
# Set public key here; private key in Supabase Edge Function secrets as VAPID_PRIVATE_KEY
VITE_VAPID_PUBLIC_KEY=

# Edge function: dispatch-notification
# SUPABASE_SERVICE_ROLE_KEY (auto in Supabase)
# RESEND_API_KEY (optional email fallback)
# NOTIFICATION_FROM_EMAIL=notifications@yourdomain.com
# PUBLIC_APP_URL=https://www.drumlessonsbymark.com

# Website contact form edge function (submit-contact-inquiry)
# RECAPTCHA_SECRET_KEY=your-recaptcha-secret
# PRIMARY_TEACHER_USER_ID=optional-mark-teacher-uuid (defaults to first teacher in user_roles)
